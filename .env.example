PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
ADMIN_PASSWORD=replace-with-a-long-random-password
DATA_DIR=.data
WEDE_IMAGE=codingbox-wede:local
MAX_ACTIVE_ROOMS=5
MAX_CONCURRENT_EXPORTS=2
ROOM_MEMORY=1g
ROOM_CPUS=1
# Optional Linux/BoxLite preview mode (Docker is the default):
# RUNTIME=native
# WEDE_BINARY=/opt/codingbox/bin/wede
# Production: PUBLIC_URL=https://app.boxlite.ai
# Route app.boxlite.ai to this server; all rooms use /rooms/{code}/.
